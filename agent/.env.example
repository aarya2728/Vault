# NEAR
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
VAULT_CONTRACT=vault.you.testnet
AGENT_ACCOUNT=agent.you.testnet
# Function-call key only. Never put the vault's full-access key here.
AGENT_PRIVATE_KEY=ed25519:replace_me

# 1Click
ONECLICK_BASE_URL=https://1click.chaindefuser.com
# Optional partner JWT. Without it you pay the unauthenticated fee.
ONECLICK_JWT=
# false requests a live quote (deposit address + minAmountOut). Safe in DRY_RUN
# because the agent never sends the deposit transaction.
QUOTE_DRY=false

# Assets (mainnet 1Click ids; Intents has no testnet)
# USDC on NEAR
ORIGIN_ASSET=nep141:17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1
# USDC on Arbitrum
DESTINATION_ASSET=nep141:arb-0xaf88d065e77c8cc2239327c5edb3a432268e5831.omft.near
# Address on Arbitrum that receives the external leg (venue or your wallet).
# Must be a valid checksum-free lowercase EVM address; 1Click rejects the zero address.
DESTINATION_RECIPIENT=0x1111111111111111111111111111111111111111
# Both sides of the default demo pair are USDC.
ORIGIN_DECIMALS=6
DESTINATION_DECIMALS=6

# Strategy
# 25 USDC (6 decimals). Small enough for a demo, large enough that gas does
# not dominate the annualized cost.
REBALANCE_AMOUNT=25000000
SLIPPAGE_BPS=100
MIN_SPREAD_BPS=150
NEAR_APY_BPS=450
# Baseline external venue assumption, not a live protocol rate. venue.ts ranks
# five modeled venues around this value and logs the selected net opportunity.
EXTERNAL_APY_BPS=1200
HOLD_DAYS=30
NEAR_USD=5
# 100 Tgas in gas units
GAS_UNITS=100000000000000

# Loop
POLL_INTERVAL_MS=3600000
POSITION_MAX_MS=21600000
DRY_RUN=true
# (Legacy) Only set true when the mock-return script has actually returned the funds.
# With real 1Click status polling (v2), this is used as a fallback when status
# polling is unavailable.
AUTO_CLOSE_MOCK=false
LOG_FILE=data/rebalances.jsonl
STATE_FILE=data/state.json
# Read-only audit endpoint for the dashboard decision stream (npm run history).
HISTORY_PORT=8787

# 1Click Status Polling (v2)
# How often to poll 1Click getStatus during outbound_pending phase (default 30s).
STATUS_POLL_INTERVAL_MS=30000
# Max polls before logging a timeout warning (default 120 = ~1h at 30s interval).
# The agent continues polling past this; it just warns.
STATUS_POLL_MAX_RETRIES=120

# Circuit breaker: self-pause new entries after N consecutive anomalous cycles.
CIRCUIT_BREAKER_THRESHOLD=3
# 6 hours. Existing positions keep their normal settlement loop while open.
CIRCUIT_BREAKER_COOLDOWN_MS=21600000
# A quote cost above 350bps or gas above 150bps counts as anomalous.
ANOMALY_COST_BPS=350
ANOMALY_GAS_COST_BPS=150

# Demo helper only. The treasury sends principal + simulated yield back to the
# vault so rebalance_in can read it from the real FT balance. Use a full-access
# key here, never the scoped agent key.
MOCK_RETURN_ACCOUNT=treasury.you.testnet
MOCK_RETURN_PRIVATE_KEY=ed25519:replace_me
# Simulated demo yield credited on top of principal (100 = 1%).
MOCK_YIELD_BPS=100
