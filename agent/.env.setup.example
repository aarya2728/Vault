# Deploy / key setup. Copy to agent/.env.setup; never commit it.
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org

OWNER_ACCOUNT=you.testnet
OWNER_PRIVATE_KEY=ed25519:replace_me

# Keep equal to VAULT_CONTRACT in agent/.env.
VAULT_ACCOUNT=vault.you.testnet
VAULT_PRIVATE_KEY=ed25519:replace_me
VAULT_TOKEN=usdc.fakes.testnet
# Fund a newly created vault account for contract storage and gas.
VAULT_INITIAL_NEAR=5
INIT=true
# Leave blank to auto-detect target/near or target/wasm32-unknown-unknown/release.
WASM_PATH=

AGENT_ACCOUNT=agent.you.testnet
AGENT_INITIAL_NEAR=0.5
AGENT_ALLOWANCE_NEAR=0.25
AGENT_METHOD_NAMES=rebalance_out,rebalance_in
# Leave blank to generate a key and write it to agent/.env.agent-key.
AGENT_PRIVATE_KEY=
# Only needed to add/delete a key on an existing agent account.
AGENT_FULL_ACCESS_PRIVATE_KEY=
SET_AGENT=true
REVOKE_FULL_ACCESS_KEY=true

POLICY_MIN_MOVE=1000000
POLICY_MAX_PER_MOVE=10000000
POLICY_DAILY_CAP=50000000
POLICY_MAX_SLIPPAGE_BPS=100
POLICY_ALLOWED_ASSETS=nep141:arb-0xaf88d065e77c8cc2239327c5edb3a432268e5831.omft.near
# POLICY_JSON overrides the individual POLICY_* values.
