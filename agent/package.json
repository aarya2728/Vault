{
  "name": "vaultpilot-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "once": "tsx src/index.ts --once",
    "mock:return": "tsx src/mock-return.ts",
    "setup:agent": "tsx scripts/setup-agent-key.ts",
    "deploy": "tsx scripts/deploy-vault.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "build": "tsc"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "near-api-js": "^7.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
